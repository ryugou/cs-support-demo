# cs-support-mcp ローカル開発用 環境変数
# このファイルを `.env` にコピーして実際の値を記入する（.env は gitignore 済み・コミット禁止）。
#   cp .env.example .env
# 本番（Cloud Run）は Secret Manager injection を使う（平文 .env 禁止 — CLAUDE.md 参照）。

# --- vegapunk gRPC backend ---
# 認証 bearer token。取得例:
#   ssh vegapunk 'ruby -ryaml -e "c=YAML.load_file(File.expand_path(%q[~/.config/vegapunk/config.yml])); print c.dig(%q[server],%q[auth],%q[token])"'
# 未設定でも起動は成功する（main.rs は VEGAPUNK_BEARER_TOKEN 未設定時に空文字を使う）が、
# vegapunk への呼び出し（search_manual 等）だけが失敗する。ローカルで vegapunk を使うなら必須。
VEGAPUNK_BEARER_TOKEN=

# vegapunk gRPC endpoint。未設定時は config ファイル（例: config.local-https.toml）の
# `vegapunk_endpoint` 値がそのまま使われる（server/src/config.rs:218 で env が config を上書きする）。
# 通常はここではなく config ファイル側で設定すればよい。config を明示的に上書きしたい場合のみ設定する。
VEGAPUNK_ENDPOINT=

# --- signal 抽出エージェント（LLM コンポーネント / A1）---
# Anthropic API キー（sk-ant- で始まる）。https://console.anthropic.com/settings/keys
# config.toml の [llm] enabled = true のとき必須（未設定なら起動時 fail closed）。
# enabled = false（既定）なら不要（lexicon 単独・オフライン動作）。
CS_SUPPORT_LLM_API_KEY=

# --- Google OAuth 2.1（認証、必須）---
# OAuth リソースメタデータ（/.well-known/oauth-protected-resource/{project_id}/mcp）の host。
# 未設定だと起動時に fail closed で失敗する（main.rs:85-88）。
# ローカルなら 127.0.0.1:3443 等、本番なら公開ドメインを設定する。
CS_SUPPORT_PUBLIC_DOMAIN=

# Google OAuth Client ID。tokeninfo 検証の aud 照合に使う。
# 未設定だと起動時に fail closed で失敗する（main.rs:105-107）。
# client_id は公開識別子であり機密情報ではないが、値そのものは各自の Google Cloud Console 発行分を使う。
CS_SUPPORT_GOOGLE_OAUTH_CLIENT_ID=
