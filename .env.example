# cs-support-mcp ローカル開発用 環境変数
# このファイルを `.env` にコピーして実際の値を記入する（.env は gitignore 済み・コミット禁止）。
#   cp .env.example .env
# 本番（Cloud Run）は Secret Manager injection を使う（平文 .env 禁止 — CLAUDE.md 参照）。

# --- vegapunk gRPC backend ---
# 認証 bearer token。取得例:
#   ssh vegapunk 'ruby -ryaml -e "c=YAML.load_file(File.expand_path(%q[~/.config/vegapunk/config.yml])); print c.dig(%q[server],%q[auth],%q[token])"'
# 未設定でも起動は成功する（main.rs は VEGAPUNK_BEARER_TOKEN 未設定時に空文字を使う）が、
# vegapunk への呼び出し（search_manual 等）だけが失敗する。ローカルで vegapunk を使うなら必須。
VEGAPUNK_BEARER_TOKEN=

# vegapunk gRPC endpoint。未設定時は config ファイル（例: config.local-https.toml）の
# `vegapunk_endpoint` 値がそのまま使われる（server/src/config.rs:218 で env が config を上書きする）。
# 通常はここではなく config ファイル側で設定すればよい。config を明示的に上書きしたい場合のみ設定する。
VEGAPUNK_ENDPOINT=

# --- signal 抽出エージェント（LLM コンポーネント / A1）---
# Anthropic API キー（sk-ant- で始まる）。https://console.anthropic.com/settings/keys
# config.toml の [llm] enabled = true のとき必須（未設定なら起動時 fail closed）。
# enabled = false（既定）なら不要（lexicon 単独・オフライン動作）。
CS_SUPPORT_LLM_API_KEY=

# --- 翻訳エージェント（Gemini Flash 3.6 / Issue #8 answers.alarm.com ingest）---
# Google AI Studio の Gemini API キー。https://aistudio.google.com/apikey で発行。
# ingest_alarmcom が英語マニュアルを日本語へ翻訳し Concept を抽出する際に使う。
# モデル ID（gemini-3.6-flash）とエンドポイントは config の翻訳セクション側で設定する
# （キーだけが秘密。本番は Secret Manager injection）。
# 未設定でも MCP サーバ本体の起動には影響しないが、ingest_alarmcom の翻訳は失敗する。
CS_SUPPORT_GEMINI_API_KEY=

# --- OAuth 2.1（認証、必須。すべて未設定・空文字なら起動時 fail closed）---
# cs-support-mcp 自身が OAuth 2.1 認可サーバとして動作し、内部で Google に委譲する
# （Google は DCR 非対応のため、Google を直接 AS にすると claude.ai が接続できない）。

# 公開ホスト名。issuer / 各 OAuth endpoint / リソースメタデータの組み立てに使う。
# 未設定だと起動時に fail closed で失敗する（main.rs:96-100）。
# ローカルなら 127.0.0.1:3443 等、本番なら公開ドメインを設定する。
CS_SUPPORT_PUBLIC_DOMAIN=

# Google OAuth Client ID。Google への authorize / token 交換と、tokeninfo の aud 照合に使う。
# 未設定だと起動時に fail closed で失敗する（main.rs:132-136）。
# client_id は公開識別子であり機密情報ではないが、値そのものは各自の Google Cloud Console 発行分を使う。
CS_SUPPORT_GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth Client Secret。**真の秘密**。/oauth/callback での token 交換にのみ使い、
# サーバ外（クライアント・ログ・レスポンス）へは一切出さない。
# 未設定だと起動時に fail closed で失敗する（main.rs:137-141）。
# 本番は Secret Manager injection で注入する。
CS_SUPPORT_GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth 署名鍵の env は無い（意図的）。
# このサーバは自前のアクセス/リフレッシュトークンを発行せず、Google が発行した
# トークンをそのまま中継する。署名が要るのは client_id（DCR 登録）/ state /
# 認可コード / 同意ブロブだけで、その鍵は起動時に CSPRNG で生成してメモリに置く
# （server/src/oauth/signing.rs の SigningKey::generate）。Secret Manager にも置かない。
#
# 再起動すると、進行中のログインフロー（最長 600 秒）と DCR 登録は無効になるが、
# **アクセストークンとリフレッシュトークンは Google 発行なので利用者はログアウトしない**。
# DCR 登録は claude.ai が再登録すれば自動的に回復する。
